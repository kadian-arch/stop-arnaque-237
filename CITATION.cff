repository-code: "https://github.com/kadian-arch/stop-arnaque-237"
url: "https://github.com/kadian-arch/stop-arnaque-237"
license: CC-BY-4.0
keywords:
  - Cameroon
  - scam
  - fraud
  - mobile money
  - social engineering
  - SMS
  - dataset
  - Pidgin
  - French
